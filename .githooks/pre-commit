#!/bin/sh
set -e

go mod tidy -diff

files=$(git diff --cached --name-only --diff-filter=ACM -- '*.go')
if [ -n "$files" ]; then
	pkgs=$(echo "$files" | xargs -n1 dirname | sort -u | sed 's|^|./|')

	unformatted=$(gofmt -l $files)
	if [ -n "$unformatted" ]; then
		echo "gofmt: $unformatted" >&2
		exit 1
	fi

	# Mount code is Linux-only, so vet and lint it as CI sees it as well.
	go vet $pkgs
	GOOS=linux go vet $pkgs
	go test -race $pkgs

	if command -v golangci-lint >/dev/null; then
		GOOS=linux golangci-lint run $pkgs
	fi
fi

if git diff --cached --name-only --diff-filter=ACM -- charts | grep -q . && command -v helm >/dev/null; then
	helm lint charts/csi-rclone
fi
